{
  "name": "loadtest-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fabric App: parameterize, launch, follow and read the results of the Fabric Load Test Orchestrator.",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:demo": "tsc --noEmit -p tsconfig.json && vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "deploy": "rayfin up",
    "deploy:static": "rayfin up staticapp deploy"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.28.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@microsoft/rayfin-cli": "~1.36.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "marked": "^16.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
