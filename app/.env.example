# App configuration. Copy this file to .env (or let your deployment script write it). The frontend is public: no secrets here.
# Variables generated by Rayfin (VITE_RAYFIN_*, VITE_FABRIC_*) go to .env.local; do not put them here.

# Microsoft Entra single-page application registration (no secret, PKCE).
# Redirect URIs: <origin>/blank.html for local development and for the deployed app.
VITE_MSAL_CLIENT_ID=<spa-client-guid>
VITE_MSAL_TENANT_ID=<tenant-guid>

# Optional: workspace that is preselected on the Environment page (the workspace where the orchestrator is installed).
VITE_DEFAULT_WORKSPACE_ID=

# Optional: comma-separated display names of workspaces that must not be used for tests (the app shows a warning).
VITE_WARN_WORKSPACES=
