# Copia a .env y rellena. Nunca versiones .env.
AZURE_TENANT_ID=<tenant-guid>
AZURE_SUBSCRIPTION_ID=<subscription-guid>
LOCATION=<region>

# Workspace de herramientas: orquestador de carga + gate (en una capacidad distinta de la del modelo)
GATE_WORKSPACE_ID=<workspace-guid>
GATE_WORKSPACE_NAME=<workspace-name>
GATE_LAKEHOUSE_ID=<lakehouse-guid>

# App Fabric Capacity Metrics
CAPACITY_METRICS_WORKSPACE=<capacity-metrics-workspace-name>

# Deployment pipeline de Fabric del modelo (stage test -> prod)
DEPLOYMENT_PIPELINE_ID=<deployment-pipeline-guid>
STAGE_TEST_ID=<stage-guid>
STAGE_PROD_ID=<stage-guid>
