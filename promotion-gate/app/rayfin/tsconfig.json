{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "useDefineForClassFields": true,
    "noEmit": false,
    "outDir": ".temp/compiled"
  },
  "include": ["data/**/*.ts"]
}
