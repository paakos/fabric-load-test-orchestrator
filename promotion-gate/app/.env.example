# Configuración propia de la app. `deploy/deploy.ps1` escribe este fichero como .env; a mano: cópialo a .env.
# El frontend es público: aquí no van secretos, solo ids públicos.
# Las variables del backend Rayfin (VITE_RAYFIN_*, VITE_FABRIC_*) no van aquí: las genera Rayfin en .env.local.

# Registro de aplicación SPA en Entra (sin secreto). Redirect URIs: <origen>/blank.html, en local y en la app desplegada.
VITE_MSAL_CLIENT_ID=<spa-client-guid>
VITE_MSAL_TENANT_ID=<tenant-guid>

# Workspace de herramientas donde están el orquestador de carga y el gate (smgate deploy)
VITE_GATE_WORKSPACE_ID=<workspace-guid>
VITE_GATE_LAKEHOUSE_ID=<lakehouse-guid>
VITE_CAPACITY_METRICS_WORKSPACE=<capacity-metrics-workspace-name>
