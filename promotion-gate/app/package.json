{
  "name": "promotion-gate-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fabric App (Rayfin): elegir modelo semántico e informe, lanzar el gate de promoción, seguirlo y promocionar.",
  "scripts": {
    "dev": "rayfin dev",
    "dev:frontend": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "deploy": "rayfin up",
    "deploy:static": "rayfin up staticapp deploy",
    "env": "rayfin env --framework vite"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.28.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@microsoft/rayfin-auth-provider-fabric": "~1.36.2",
    "@microsoft/rayfin-client": "~1.36.2",
    "@microsoft/rayfin-core": "~1.36.2",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@microsoft/rayfin-cli": "~1.36.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
